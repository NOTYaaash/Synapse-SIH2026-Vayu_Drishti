# ------------------------------------------------------------------------------
# SIH 2026 Cyclone Tracking (.gitignore)
# ------------------------------------------------------------------------------

# Python & Django Caches
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/

# Virtual Environments & Secrets
venv/
.venv/
env/
.env

# Frontend / Node
frontend/node_modules/
frontend/dist/
frontend/.npm/

# Local Databases
db.sqlite3

# Heavy Datasets & Satellite Data
data/Order/
data/gpm_imerg/
data/ibtracs.ALL.list.v04r01.csv
*.h5
*.hdf5
*.nc
*.nc4
*.zip

# PyTorch Model Weights
*.pt
*.pth
*.onnx

# Local System / IDE / Logs
.vscode/
.idea/
*.log
*.txt
*.mp4
*.json

# Local Archives (Not tracked by Git)
_archive/

# ------------------------------------------------------------------------------
# FORCE TRACK SIH MANDATORY FOLDERS
# ------------------------------------------------------------------------------
!docs/
!submission/
!assets/
!assets/screenshots/